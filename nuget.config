<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore reads exactly one feed, and it is named here rather than inherited.

  Without this, `msbuild -t:Restore` uses whatever sources the machine happens to have configured in
  %AppData%\NuGet\NuGet.Config - a private feed from unrelated work, a stale local folder, an
  internal mirror. That is how a build succeeds for one person and fails for the next, and the error
  when it fails is a package-not-found rather than anything pointing at the configuration.

  <clear /> is the load-bearing line: adding a source without it appends to the inherited list
  instead of replacing it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
