<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsTSPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTSPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tabula Sonora Player">

    <!--
        No Background on this Grid, and that is load-bearing rather than an omission. A backdrop is
        drawn behind the window's content, so any opaque brush anywhere up this tree hides it
        completely - and the failure looks like Mica not being applied rather than like something
        painting over it.
    -->
    <!--
        AllowDrop on the root, so a file dropped anywhere in the window is taken. Restricting the
        target to the mixer or the transport would make the reader guess which half of the window is
        the one that accepts files, and there is no second thing a drop here could mean.
    -->
    <Grid x:Name="RootGrid" RowSpacing="12" AllowDrop="True"
          DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The title bar, drawn by the app rather than by the system.

            Extending into it is not decoration here: it is what makes the backdrop continuous. Left
            to the system, the caption strip is painted its own solid colour and the Mica stops at a
            hard edge an inch below the top of the window, which reads as a bug.

            The height is the caption height, and the right-hand padding in code keeps this clear of
            the minimise, maximise and close buttons - whose width is not a constant and has to be
            asked for.
        -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <TextBlock x:Name="TitleBarText"
                       Text="Tabula Sonora Player"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </Grid>

        <!--
            Opening files still lives on a row of buttons. The menu, the drag target and the
            recent-files list arrive with the settings milestone; until then this is what puts a ROM
            and a song into the model.
        -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,0">
            <Button x:Name="OpenRomButton" Content="Import SCCore.dll..." Click="OnOpenRomClick" />
            <Button x:Name="OpenSongButton" Content="Open song..." IsEnabled="False" Click="OnOpenSongClick" />

            <!--
                Recent songs. A DropDownButton rather than a SplitButton: its primary half would have
                to mean "open the most recent one", and a button whose click target does something
                different from its arrow is how people open the wrong file.
            -->
            <DropDownButton x:Name="RecentButton" Content="Recent" IsEnabled="False">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="RecentFlyout" Placement="Bottom" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button x:Name="ExportButton" Content="Export WAV..." IsEnabled="False" Click="OnExportClick" />
            <Button x:Name="PrefsButton" Content="Preferences..." Click="OnPrefsClick" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="No ROM loaded." />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6" Margin="16,0">
            <local:TransportView x:Name="Transport" />
            <TextBlock x:Name="ChurnText" FontFamily="Consolas" Opacity="0.5" FontSize="11" Text="" />
        </StackPanel>

        <!--
            The mixer, raised onto a layer.

            This is the half of the two-material effect that the backdrop API cannot give directly:
            the window carries Mica Alt, the chrome above shows it bare, and the layer brush here
            lifts the mixer back towards the lighter weight of plain Mica. LayerFillColorDefault is
            the brush Fluent defines for exactly this - translucent, so the material still moves with
            the desktop behind it, rather than an opaque panel that would blank it.

            The stroke is what makes it read as a raised surface rather than as a patch of slightly
            different tint.

            Flush to the window on three sides, with the breathing room inside as padding rather than
            outside as margin. A margin would leave a strip of bare Mica Alt below and beside the
            mixer, which reads as the card floating in a gap rather than as the window's content
            area; and the sixteen strips this has to fit would be paying for that gap twice, once at
            each end. So the bottom border and the bottom corners go - they would be sitting on the
            window's own rounded edge - and only the top corners stay rounded.
        -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0"
                Padding="8,8,8,0">
            <local:MixerView x:Name="Mixer" />
        </Border>
    </Grid>
</Window>
