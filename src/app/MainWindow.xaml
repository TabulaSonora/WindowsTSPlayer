<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsTSPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTSPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tabula Sonora Player">

    <!--
        Still deliberately unlovely. This milestone is the model, not the interface: the strip layout,
        the height budget that fits sixteen parts on screen, the faders and their echo latch all
        arrive later. What has to be right here is that the rows are built once and updated in place,
        which is a thing you watch rather than read.
    -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenRomButton" Content="Open SCCore.dll..." Click="OnOpenRomClick" />
            <Button x:Name="OpenSongButton" Content="Open song..." IsEnabled="False" Click="OnOpenSongClick" />
            <Button x:Name="PlayPauseButton" Content="Pause" IsEnabled="False" Click="OnPlayPauseClick" />
            <Button x:Name="RestartButton" Content="Restart" IsEnabled="False" Click="OnRestartClick" />
            <Button x:Name="PanicButton" Content="Panic" IsEnabled="False" Click="OnPanicClick" />
            <ToggleButton x:Name="LoopButton" Content="Loop" IsEnabled="False" Click="OnLoopClick" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="No ROM loaded." />
            <TextBlock x:Name="EngineText" FontFamily="Consolas" Text="engine idle" />
            <TextBlock x:Name="ChurnText" FontFamily="Consolas" Opacity="0.6" Text="" />
        </StackPanel>

        <!--
            SelectionMode None because a mixer strip is not a selectable thing; the row is a set of
            readouts and, later, controls. IsItemClickEnabled stays off for the same reason.
        -->
        <ListView Grid.Row="2"
                  x:Name="PartList"
                  SelectionMode="None"
                  ItemsSource="{x:Bind Model.VisibleParts, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PartModel">
                    <!-- Dimmed is bound but not yet rendered: showing "something else is soloed"
                         is a mixer-styling question and arrives with the strip layout. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontFamily="Consolas"
                                   Text="{x:Bind Label, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind Address, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind Voices, Mode=OneWay}" />
                        <TextBlock Grid.Column="3"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind Detail, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
