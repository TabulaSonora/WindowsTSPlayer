<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsTSPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTSPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tabula Sonora Player">

    <!--
        No Background on this Grid, and that is load-bearing rather than an omission. A backdrop is
        drawn behind the window's content, so any opaque brush anywhere up this tree hides it
        completely - and the failure looks like Mica not being applied rather than like something
        painting over it.
    -->
    <!--
        AllowDrop on the root, so a file dropped anywhere in the window is taken. Restricting the
        target to the mixer or the transport would make the reader guess which half of the window is
        the one that accepts files, and there is no second thing a drop here could mean.
    -->
    <Grid x:Name="RootGrid" RowSpacing="12" AllowDrop="True"
          DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            One strip, doing three jobs: it is the title bar, it carries the commands, and it says
            what is loaded.

            They were three rows and the merge is a real simplification rather than a rearrangement.
            The caption said the program's name, which the taskbar and Alt-Tab already say; the
            command bar's status line said the ROM; and the transport's heading said the song and the
            ROM again. Two of those were the same sentence in two places, and the third was a constant.

            Extending into the caption is what makes the backdrop continuous. Left to the system, that
            strip is painted its own solid colour and the Mica stops at a hard edge an inch below the
            top of the window, which reads as a bug.

            48 tall, with the system asked for its matching tall caption in code. At the standard 32
            there is no room for a second line, and the two lines are the point: the song is the
            heading and what it is playing on is the note under it.
        -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The draggable half, and it is a separate element from the strip for a reason that is
                not stylistic: interactive content inside a SetTitleBar region does not receive input.
                Handing the whole strip over would turn every command in it into a place to pick the
                window up by. So only this column is the title bar; the command bar beside it is
                ordinary content.

                Starred, so the empty space between the text and the commands drags too. A title bar
                that can only be grabbed by its lettering is one people miss.
            -->
            <Grid x:Name="TitleDragArea" Grid.Column="0">
                <StackPanel Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBarText"
                               Text="Tabula Sonora Player"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <!--
                        One line for two jobs, and they take turns rather than sharing: normally it
                        says what the file is being played on, and while something is happening or has
                        failed it says that instead. Two lines would leave one of them blank almost
                        always.
                    -->
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis"
                               Text="No ROM loaded." />
                </StackPanel>
            </Grid>

            <!--
                The commands.

                Background explicitly transparent, which is load-bearing rather than tidy: a CommandBar
                paints its own surface by default, and an opaque block up here would cut the Mica
                exactly where extending into the title bar has just made it whole.

                DefaultLabelPosition is Right, not the default Bottom. Bottom stacks the label under
                the icon and needs about seventy pixels; every one of them would come out of the mixer,
                which exists to fit all sixteen parts of a GM score on screen at once. Labels beside
                icons keep this to the one line the caption already occupies, which is the whole reason
                the three rows collapse into one.

                Labels at all, rather than icons alone. Half of these are irreversible or slow - an
                export runs for minutes - and a glyph with a tooltip is not enough to tell them apart
                at a glance.
            -->
            <CommandBar Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsOpen="False"
                        OverflowButtonVisibility="Auto"
                        VerticalAlignment="Center">

                <!--
                    Importing is a first-run step and this hides once there is a ROM, so it stays a
                    primary command rather than going to the overflow: the one run where it matters is
                    the run where nothing else on this bar is enabled yet, and burying it behind an
                    ellipsis on that run would be the worst possible placement.
                -->
                <AppBarButton x:Name="OpenRomButton" Label="Import SCCore.dll" Click="OnOpenRomClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="OpenSongButton" Label="Open song" IsEnabled="False" Click="OnOpenSongClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!--
                    Recent songs, as a button that only opens a flyout. Not a SplitButton: its primary
                    half would have to mean "open the most recent one", and a control whose click
                    target does something different from its arrow is how people open the wrong file.
                -->
                <AppBarButton x:Name="RecentButton" Label="Recent" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="RecentFlyout" Placement="Bottom" />
                    </AppBarButton.Flyout>
                </AppBarButton>

                <AppBarSeparator />

                <!--
                    Song information, in a window of its own rather than a flyout or a dialog. What a
                    file says about itself runs to three pages, and reading the credits of a piece
                    while it plays is the case it exists for - which a modal dialog would prevent.
                -->
                <AppBarButton x:Name="SongInfoButton" Label="Song info" IsEnabled="False" Click="OnSongInfoClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="ExportButton" Label="Export WAV" IsEnabled="False" Click="OnExportClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <!--
                    Preferences goes to the overflow, which is where Windows has put it for a decade.
                    It is the one command here that is never part of playing a file, and the only one
                    whose absence from the visible row costs nothing.
                -->
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="PrefsButton" Label="Preferences" Click="OnPrefsClick">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>


        <StackPanel Grid.Row="1" Spacing="6" Margin="16,0">
            <local:TransportView x:Name="Transport" />
            <TextBlock x:Name="ChurnText" FontFamily="Consolas" Opacity="0.5" FontSize="11" Text="" />
        </StackPanel>

        <!--
            The mixer, raised onto a layer.

            This is the half of the two-material effect that the backdrop API cannot give directly:
            the window carries Mica Alt, the chrome above shows it bare, and the layer brush here
            lifts the mixer back towards the lighter weight of plain Mica. LayerFillColorDefault is
            the brush Fluent defines for exactly this - translucent, so the material still moves with
            the desktop behind it, rather than an opaque panel that would blank it.

            The stroke is what makes it read as a raised surface rather than as a patch of slightly
            different tint.

            Flush to the window on three sides, with the breathing room inside as padding rather than
            outside as margin. A margin would leave a strip of bare Mica Alt below and beside the
            mixer, which reads as the card floating in a gap rather than as the window's content
            area; and the sixteen strips this has to fit would be paying for that gap twice, once at
            each end. So the bottom border and the bottom corners go - they would be sitting on the
            window's own rounded edge - and only the top corners stay rounded.
        -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0"
                Padding="8,8,8,0">
            <local:MixerView x:Name="Mixer" />
        </Border>
    </Grid>
</Window>
