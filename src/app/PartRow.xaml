<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsTSPlayer.PartRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTSPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The faders, which stock are by a wide margin the tallest thing on a strip: 14px of margin
            above and below a 4px track, 32px in total.

            The margins carry the height, not the track, so they are what has to come down, and the
            thumb has to come with them or it clips. At 6/4/6 the control measures 16px, comfortably
            under the 22px the mute and solo toggles already set as the strip's floor, so adding
            faders costs no height at all.

            SliderHorizontalHeight has to be set as well as the margins. It is the control's own
            height and does not follow from them; left at 32 it would hold the strip open on its own
            while the track sat in the middle of the empty space.

            Scoped to this control rather than set globally: a 4px track is right on a strip and
            wrong on the transport's gain slider, and the export bar there needed the opposite
            correction entirely.
        -->
        <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
        <x:Double x:Key="SliderPreContentMargin">6</x:Double>
        <x:Double x:Key="SliderPostContentMargin">6</x:Double>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
        <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
        <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
    </UserControl.Resources>

    <!--
        One mixer strip: address, name and chips, two faders, the voice meter, mute and solo.

        About 32px tall, which is the whole point and is enforced by Styles.xaml rather than here.
        Nothing in this markup may be taller than the 22px toggles without the sixteen-parts-on-screen
        budget going with it.
    -->
    <Grid x:Name="Root" ColumnSpacing="8" Padding="0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="AddressText" Grid.Column="0"
                   FontFamily="Consolas" FontSize="12"
                   VerticalAlignment="Center" />

        <!--
            Name and chips share a row and compete for the same width; which of them survives a
            narrow strip is decided in code, not by the layout. See PartRow::ApplyWidth.
        -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" FontSize="12" />
            <TextBlock x:Name="TagsText" Opacity="0.55" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Slider x:Name="VolumeFader" Grid.Column="2"
                Style="{StaticResource MixerFaderStyle}"
                Minimum="0" Maximum="127"
                VerticalAlignment="Center" />

        <!--
            Pan starts at 1, not 0. The engine folds a CC#10 of zero up to one because the controller
            cannot express the random-pan setting - only the GS panpot SysEx can write that - so a
            fader whose bottom end silently became something else would be lying about its own travel.
        -->
        <Grid Grid.Column="3" VerticalAlignment="Center">
            <!--
                The centre mark, drawn behind the track as a one-pixel rule. A TickBar is the obvious
                way to say this and costs about twelve pixels of height, which is most of a strip; a
                rectangle costs none. Dimmed to the weight of an empty track so it reads as a scale
                marking rather than as a value.
            -->
            <Rectangle Width="1" Height="6" Opacity="0.35"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Slider x:Name="PanFader"
                    Style="{StaticResource MixerFaderStyle}"
                    Minimum="1" Maximum="127"
                    VerticalAlignment="Center" />
        </Grid>

        <local:VoiceMeter x:Name="Meter" Grid.Column="4" VerticalAlignment="Center" />

        <ToggleButton x:Name="MuteButton" Grid.Column="5" Content="M"
                      Style="{StaticResource MixerToggleStyle}"
                      Click="OnMuteClick"
                      ToolTipService.ToolTip="Mute this part" />
        <ToggleButton x:Name="SoloButton" Grid.Column="6" Content="S"
                      Style="{StaticResource MixerToggleStyle}"
                      Click="OnSoloClick"
                      ToolTipService.ToolTip="Solo this part" />
    </Grid>
</UserControl>
