<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WindowsTSPlayer.TransportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTSPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">

        <!-- Heading -->
        <StackPanel Spacing="2">
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       Text="No file open" />
            <TextBlock x:Name="SubtitleText" Opacity="0.6" Text="" />
        </StackPanel>

        <!-- Scrubber -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Fixed widths, for the same reason the controls row below is laid out the way it is:
                these are Auto columns either side of the starred scrubber, so a readout that grows
                when the song passes ten minutes would shorten the slider and shift its handle. Wide
                enough for "-00:00" so nothing has to reflow at any length this program can show.
            -->
            <TextBlock x:Name="ElapsedText" Grid.Column="0"
                       FontFamily="Consolas" MinWidth="46" TextAlignment="Right"
                       VerticalAlignment="Center" Text="0:00" />

            <!--
                StepFrequency is a second, not the default, which for a range of a few hundred is
                coarse enough to make the keyboard useless on a long song. SmallChange follows it.
            -->
            <Slider x:Name="Scrubber" Grid.Column="1"
                    Minimum="0" Maximum="1"
                    StepFrequency="1" SmallChange="1" LargeChange="10"
                    IsThumbToolTipEnabled="False"
                    IsEnabled="False"
                    VerticalAlignment="Center" />

            <TextBlock x:Name="TotalText" Grid.Column="2"
                       FontFamily="Consolas" MinWidth="46"
                       VerticalAlignment="Center" Text="0:00" />
        </Grid>

        <!-- Controls -->
        <!--
            Auto, Auto, star - not Auto, star, Auto.

            The obvious arrangement centres the gain in a starred middle column, and that column's
            width is then whatever the status readouts on the right are not using. So the gain slider
            moved every time the voice count crossed from two digits to one, or the XG badge
            appeared, or a dropout count showed up: the handle drifted under the pointer for reasons
            that had nothing to do with the pointer.

            Sizing the gain to its content and letting the status take the slack fixes it at the
            source. The status is right-aligned inside the starred column, so when it changes width it
            grows leftwards into empty space and nothing to its left moves at all.
        -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button x:Name="RestartButton" IsEnabled="False" Click="OnRestartClick"
                        ToolTipService.ToolTip="Back to the start">
                    <FontIcon Glyph="&#xE100;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                </Button>
                <Button x:Name="PlayButton" IsEnabled="False" Click="OnPlayClick">
                    <FontIcon x:Name="PlayGlyph" Glyph="&#xE102;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                </Button>
                <ToggleButton x:Name="LoopButton" IsEnabled="False" Click="OnLoopClick"
                              ToolTipService.ToolTip="Loop at the file's own loop points">
                    <FontIcon Glyph="&#xE1CD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                </ToggleButton>
                <!--
                    ErrorBadge, not a stop square. Panic does not stop playback: it silences every
                    sounding note and leaves the transport running, so a stop glyph describes the
                    wrong action and sits next to a play/pause button that already owns that meaning.

                    Every icon here asks for SymbolThemeFontFamily rather than naming a font, so one
                    family answers for all of them and the set can be changed without auditing which
                    codepoints live where.
                -->
                <Button x:Name="PanicButton" IsEnabled="False" Click="OnPanicClick"
                        ToolTipService.ToolTip="Silence every sounding note">
                    <FontIcon Glyph="&#xEA39;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Gain -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE767;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Opacity="0.6" />
                <Slider x:Name="GainSlider" Width="120"
                        Minimum="0" Maximum="2" StepFrequency="0.01"
                        IsThumbToolTipEnabled="False"
                        Value="1"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="GainReadout" FontFamily="Consolas" VerticalAlignment="Center"
                           Width="44" Text="100%" />
            </StackPanel>

            <!-- Status -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="VoicesText" FontFamily="Consolas" Opacity="0.7" Text="0/0 voices" />
                <Border x:Name="XgBadge" Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="3" Padding="5,1">
                    <TextBlock Text="XG" FontSize="11"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="DropoutsText" Visibility="Collapsed" Opacity="0.7"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="" />
            </StackPanel>
        </Grid>

        <!--
            Export progress, present only while an export is running. A row of its own rather than a
            button in the transport: file operations belong in a menu, and a permanently-present
            "Export WAV..." button was single-handedly setting the window's minimum width in the GTK
            build.
        -->
        <Grid x:Name="ExportRow" Visibility="Collapsed" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Exporting" Opacity="0.7" VerticalAlignment="Center" />

            <!--
                Indeterminate, and there is no Cancel button beside it, because Session::run_export
                renders the whole song in one render_to_end call and reports only 0.0 before it and
                1.0 after. That is deliberate upstream and load-bearing: chunked rendering produces
                genuinely different audio, since span boundaries decide where events land once the
                engine rounds their stamps to the millisecond, and it was the chunked form that
                stopped matching `tabula-sonora render`. Byte-identical export is the one thing
                export-matches-cli exists to prove, so it wins over a moving bar.

                Two consequences follow and both are honest rather than worked around. A determinate
                bar would sit at zero and then vanish, so this pulses. And a render already under way
                cannot be interrupted, so offering Cancel would be offering a button that does
                nothing - the progress callback is not consulted again until the render is over.

                Still thickened past the stock 3px-over-1px hairline: this is the only feedback for
                an operation that can run for minutes.
            -->
            <ProgressBar x:Name="ExportProgress" Grid.Column="1"
                         IsIndeterminate="True"
                         VerticalAlignment="Center">
                <ProgressBar.Resources>
                    <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
                    <x:Double x:Key="ProgressBarMinHeight">8</x:Double>
                    <CornerRadius x:Key="ProgressBarCornerRadius">4</CornerRadius>
                    <CornerRadius x:Key="ProgressBarTrackCornerRadius">4</CornerRadius>
                </ProgressBar.Resources>
            </ProgressBar>
        </Grid>
    </StackPanel>
</UserControl>
