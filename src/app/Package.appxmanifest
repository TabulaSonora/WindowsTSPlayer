<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Identity is what the file associations and the media transport controls hang off, which is why
    this program is packaged at all rather than shipped as a loose .exe. Both of those are
    identity-gated: an unpackaged build can play audio, but Explorer will not offer it for a .mid
    and the now-playing flyout will not know it exists.

    Publisher must match the signing certificate's subject character for character, or packaging
    fails with APPX0104. For the development loop none of that applies - `Add-AppxPackage -Register`
    over the loose AppX layout grants identity with no signature at all - so this stays a plain
    development subject until there is a certificate to match.
  -->
  <Identity
    Name="co.losno.TabulaSonoraPlayer"
    Publisher="CN=TabulaSonora"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>Tabula Sonora Player</DisplayName>
    <PublisherDisplayName>Tabula Sonora</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Tabula Sonora Player"
        Description="A front end for NativeTS, a reimplementation of the Roland Sound Canvas VA voice"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!--
          Unqualified names, deliberately. Every one of these resolves to a scale-qualified file
          (Square150x150Logo.scale-200.png and so on) that tools\Convert-Icons.ps1 generated; MRT
          picks the variant matching the display. Naming a scale here instead would pin the tile to
          one density.
        -->
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          The twelve extensions the Linux front end accepts, verbatim, and this single block replaces
          both halves of what that build needed: the desktop entry's MimeType line and the whole
          107-line shared-mime-info XML beside it. Windows dispatches on extension alone, so the
          magic-number rules that file existed to carry have no counterpart here and are not a loss.

          One association rather than twelve. They are one kind of thing to a reader, they are opened
          by one program in one way, and twelve entries would be twelve rows in the Default Apps list
          saying the same sentence.

          Note .lds among them. It is the one format with no magic number at all, recognised by its
          extension and nothing else, which is what made the two-separator fix in Session::file_name
          load-bearing rather than cosmetic.

          AllowSilentDefaultTakeOver is left at its default of false, deliberately. Set true, this
          would seize .mid from whatever holds it the moment the package registers; left alone, the
          program appears in "Open with" and waits to be chosen. Taking a file type without being
          asked is the behaviour that makes people uninstall media players.
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="midi">
            <uap:DisplayName>MIDI sequence</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.mid</uap:FileType>
              <uap:FileType>.midi</uap:FileType>
              <uap:FileType>.rmi</uap:FileType>
              <uap:FileType>.mids</uap:FileType>
              <uap:FileType>.mus</uap:FileType>
              <uap:FileType>.xmi</uap:FileType>
              <uap:FileType>.xmf</uap:FileType>
              <uap:FileType>.mxmf</uap:FileType>
              <uap:FileType>.gmf</uap:FileType>
              <uap:FileType>.hmi</uap:FileType>
              <uap:FileType>.hmp</uap:FileType>
              <uap:FileType>.lds</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust is what keeps this a desktop process with the full user token rather than an
      AppContainer, and it is a hard requirement rather than a convenience: src/host/ opens songs
      with std::ifstream on a raw filesystem path, shared verbatim with the Apple and Linux ports.
      Inside an AppContainer that open fails, and the alternative would be a StorageFile-based
      reader inside src/host/ - which would fork the directory from the other two front ends.
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
